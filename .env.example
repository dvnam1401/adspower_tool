# AdsPower Local API Settings
# Default port is 50325 (or check in AdsPower app: Settings -> Local API)
ADSPOWER_API_URL=http://127.0.0.1:50325
ADSPOWER_API_KEY=

# LLM Provider Configuration (for Self-Healing Agent)
# Supported: gemini, anthropic, openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# YouTube Data API v3 (workflow "YouTube: Tổng Hợp Video Theo Profile")
# Tạo tại Google Cloud Console -> Enable "YouTube Data API v3" -> Credentials -> API Key.
# Chỉ đọc dữ liệu công khai của kênh nên KHÔNG cần OAuth. Quota mặc định 10.000 units/ngày.
YOUTUBE_API_KEY=

# Concurrency & Resource Settings
MAX_CONCURRENT_PROFILES=5
PROFILE_START_TIMEOUT_MS=30000
DOM_ACTION_TIMEOUT_MS=15000

# Storage & Logging
DATABASE_PATH=./data/adspower_automation.sqlite
LOG_LEVEL=info

# =============================================================================
# Account Hub Feature Flags
# All flags default to false/safe. Enable one phase at a time.
# =============================================================================

# Master switch — set to true to activate the Account Hub subsystem.
# When false, no router, database, scheduler or Google connection is initialised.
ACCOUNT_HUB_ENABLED=false

# Path for the dedicated Account Hub SQLite database (separate from the main DB).
ACCOUNT_HUB_DB_PATH=./data/account-hub.sqlite

# Enable outbound Google Sheets sync jobs (Phase 4).
# Only turn on after testing with ACCOUNT_HUB_SHEET_TEST_SPREADSHEET_ID.
ACCOUNT_HUB_SHEET_SYNC_ENABLED=false

# Enable AdsPower reconciliation background job (Phase 5).
ACCOUNT_HUB_ADSPOWER_RECONCILE_ENABLED=false

# Enable bulk profile import queue (Phase 6).
ACCOUNT_HUB_AUTO_IMPORT_ENABLED=false

# Enable auto-login queue after import (Phase 6).
ACCOUNT_HUB_AUTO_LOGIN_ENABLED=false

# Dry-run mode — when true, no writes to Google Sheets or AdsPower are made.
# Set to false only on a test Sheet/group first. Defaults to true for safety.
ACCOUNT_HUB_DRY_RUN=true

# AES-256-GCM key for at-rest encryption of secret columns (password, cookie, etc.).
# MANDATORY when ACCOUNT_HUB_ENABLED=true — the subsystem refuses to start without it.
# 32-byte key as 64 hex chars or base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the real key.
# ACCOUNT_HUB_ENCRYPTION_KEY=

# Path to Google service account credentials JSON (Phase 3+).
# Never commit this file. Keep outside the repository.
# ACCOUNT_HUB_GOOGLE_CREDENTIALS_PATH=/path/to/service-account.json
