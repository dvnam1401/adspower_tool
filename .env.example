# AdsPower Local API Settings
# Default port is 50325 (or check in AdsPower app: Settings -> Local API)
ADSPOWER_API_URL=http://127.0.0.1:50325
ADSPOWER_API_KEY=

# LLM Provider Configuration (for Self-Healing Agent)
# Supported: gemini, anthropic, openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Concurrency & Resource Settings
MAX_CONCURRENT_PROFILES=5
PROFILE_START_TIMEOUT_MS=30000
DOM_ACTION_TIMEOUT_MS=15000

# Storage & Logging
DATABASE_PATH=./data/adspower_automation.sqlite
LOG_LEVEL=info
